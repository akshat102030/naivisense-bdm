				    Source = Csv.Document(File.Contents(DataFolder & "\processed\fact_session.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date","month_start","week_start","start_hour","duration_min","is_attended","is_past","attention_score","communication_score","motor_score","behavior_score","avg_session_score","tantrum_observed","follow_up_required"}),
