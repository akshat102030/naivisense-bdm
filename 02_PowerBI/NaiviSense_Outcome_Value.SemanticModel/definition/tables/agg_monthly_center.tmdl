	partition agg_monthly_center = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\processed\agg_monthly_center.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"month_start","sessions_scheduled","sessions_attended","attendance_rate","avg_session_score","active_children","revenue_billed_inr","revenue_collected_inr","alerts_raised","avg_overall_assessment"}),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"month_start", type date},{"sessions_scheduled", Int64.Type},{"sessions_attended", Int64.Type},{"attendance_rate", type number},{"avg_session_score", type number},{"active_children", Int64.Type},{"revenue_billed_inr", Int64.Type},{"revenue_collected_inr", Int64.Type},{"alerts_raised", Int64.Type},{"avg_overall_assessment", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
