	partition fact_goal = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\processed\fact_goal.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"priority","created_date","target_date","is_completed"}),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"goal_id", type text},{"child_id", type text},{"title", type text},{"status", type text},{"priority", Int64.Type},{"created_date", type date},{"target_date", type date},{"is_completed", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
