		lineageTag: 72cfca34-c9d5-4c44-8a99-d4773957d338
		summarizeBy: sum
		sourceColumn: progress_points

	column 'Value Group' =
			VAR HiFee = agg_child_summary[billed_inr] >= MEDIAN ( agg_child_summary[billed_inr] )
			VAR HiPP  = agg_child_summary[progress_points] >= MEDIAN ( agg_child_summary[progress_points] )
			RETURN SWITCH ( TRUE (), HiFee && HiPP, "Thriving", NOT HiFee && HiPP, "Efficient", HiFee && NOT HiPP, "Under-served", "At-risk" )
		dataType: string
		lineageTag: 100568e2-23d5-4c87-9297-080800a0502f
		summarizeBy: none

	column 'Fee Tier' =
			SWITCH ( TRUE (), agg_child_summary[monthly_fee_inr] < 12000, "1 Under 12k", agg_child_summary[monthly_fee_inr] < 15000, "2 12k-15k", "3 15k and above" )
		dataType: string
		lineageTag: 99f9b049-3bc9-41c6-98e2-0ef4228c0f1b
		summarizeBy: none

	partition agg_child_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\processed\agg_child_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"sessions_past","sessions_attended","attendance_rate","avg_session_score","session_score_first_half","session_score_second_half","initial_overall_score","latest_overall_score","improvement_pts","improvement_pct","months_tracked","risk_improved","alerts_total","alerts_open","high_severity_alerts","billed_inr","collected_inr","outstanding_inr","home_tasks_per_week","meals_logged_per_week","goals_total","goals_completed","churn_risk","subscription_invoices","monthly_fee_inr","progress_points"}),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"child_id", type text},{"child_code", type text},{"sessions_past", Int64.Type},{"sessions_attended", Int64.Type},{"attendance_rate", type number},{"avg_session_score", type number},{"session_score_first_half", type number},{"session_score_second_half", type number},{"initial_overall_score", type number},{"latest_overall_score", type number},{"improvement_pts", type number},{"improvement_pct", type number},{"months_tracked", Int64.Type},{"initial_risk", type text},{"latest_risk", type text},{"risk_improved", Int64.Type},{"alerts_total", Int64.Type},{"alerts_open", Int64.Type},{"high_severity_alerts", Int64.Type},{"billed_inr", Int64.Type},{"collected_inr", Int64.Type},{"outstanding_inr", Int64.Type},{"home_tasks_per_week", type number},{"meals_logged_per_week", type number},{"goals_total", Int64.Type},{"goals_completed", Int64.Type},{"engagement_segment", type text},{"churn_risk", Int64.Type},{"subscription_invoices", Int64.Type},{"monthly_fee_inr", Int64.Type},{"progress_points", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
