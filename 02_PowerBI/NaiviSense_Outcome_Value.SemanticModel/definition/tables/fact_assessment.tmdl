				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"assessment_date","month_start","seq","overall_score_pct","developmental_quotient","attention","behavioral","social_communication","receptive_language","expressive_language","speech_production","imitation","visual_perception","fine_motor","gross_motor","sensory","adl","academics","cognitive","emotional_regulation"}),
