table _Measures
	lineageTag: 25a238b9-c513-4942-b506-e03f901d6d12

	measure Students = DISTINCTCOUNT ( dim_child[child_id] )
		formatString: 0
		displayFolder: Core
		lineageTag: 53ff27f9-cc93-4152-b35a-85e879a0f496

	measure Therapists = DISTINCTCOUNT ( dim_therapist[therapist_id] )
		formatString: 0
		displayFolder: Core
		lineageTag: b034ee04-775f-4489-9e3b-581e74d84621

	measure 'Sessions Held' = CALCULATE ( COUNTROWS ( fact_session ), fact_session[is_past] = 1 )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 8a443494-b4db-47de-9a07-520db78a1dcc

	measure 'Sessions Attended' = CALCULATE ( COUNTROWS ( fact_session ), fact_session[is_attended] = 1 )
		formatString: #,##0
		displayFolder: Core
		lineageTag: f1f57422-8535-4e56-a40f-baa1ee5fde00

	measure 'Attendance %' = DIVIDE ( [Sessions Attended], [Sessions Held] )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: d53ac441-371a-442f-9087-d56432dad154

	measure 'Avg Session Score' = AVERAGE ( fact_session[avg_session_score] )
		formatString: 0.00
		displayFolder: Core
		lineageTag: 85cbbe4b-0b4a-49ee-8b90-606e188f1fb7

	measure 'Progress Points' = SUM ( agg_child_summary[progress_points] )
		formatString: #,##0.0
		displayFolder: Value
		lineageTag: 26181bba-d75e-49b6-9dd2-012e88966ddd

	measure 'Fees INR' = SUM ( agg_child_summary[billed_inr] )
		formatString: "₹"#,##0
		displayFolder: Value
		lineageTag: 5e8d2f85-3f7b-4254-83ff-d48b8ceb22b8

	measure 'League Progress Points' = CALCULATE ( [Progress Points], ALL ( agg_child_summary ), ALL ( dim_child ) )
		formatString: #,##0.0
		displayFolder: Value
		lineageTag: 703e484d-822a-421d-8826-8911bf2db25d

	measure 'League Fees INR' = CALCULATE ( [Fees INR], ALL ( agg_child_summary ), ALL ( dim_child ) )
		formatString: "₹"#,##0
		displayFolder: Value
		lineageTag: f7d0cd52-af66-490c-97c6-f50f8d223dd3

	measure 'Outcome Value Index' = DIVIDE ( DIVIDE ( [Progress Points], [League Progress Points] ), DIVIDE ( [Fees INR], [League Fees INR] ) )
		formatString: 0.00
		displayFolder: Value
		lineageTag: 2025704e-e4c8-47f0-8926-e6d7bea97ece

	measure 'Fair Value INR' = [League Fees INR] * DIVIDE ( [Progress Points], [League Progress Points] )
		formatString: "₹"#,##0
		displayFolder: Value
		lineageTag: 1b49a7a6-9e69-4bd0-8edc-bf0fa49681ce

	measure 'Overpay INR' = [Fees INR] - [Fair Value INR]
		formatString: "₹"#,##0;-"₹"#,##0
		displayFolder: Value
		lineageTag: b97ca1f9-29f3-4f00-9b62-de66f54c01fd

	measure 'Therapist Progress Points' = SUM ( fact_child_therapist[attributed_progress_points] )
		formatString: #,##0.0
		displayFolder: Value
		lineageTag: b63f45dd-6890-4583-ad2b-69ace7cd2ba0

	measure 'Therapist Fees INR' = SUM ( fact_child_therapist[attributed_fees_inr] )
		formatString: "₹"#,##0
		displayFolder: Value
		lineageTag: fb4fc31a-4b60-4dbf-93c8-c6a905b44fc0

	measure 'Therapist Value Index' =
			VAR LeaguePP = CALCULATE ( [Therapist Progress Points], ALL ( fact_child_therapist ), ALL ( dim_therapist ), ALL ( dim_child ) )
			VAR LeagueFee = CALCULATE ( [Therapist Fees INR], ALL ( fact_child_therapist ), ALL ( dim_therapist ), ALL ( dim_child ) )
			RETURN DIVIDE ( DIVIDE ( [Therapist Progress Points], LeaguePP ), DIVIDE ( [Therapist Fees INR], LeagueFee ) )
		formatString: 0.00
		displayFolder: Value
		lineageTag: 58fc66ed-b3e9-4a22-969c-9b03da44a5e3

	measure Thriving = CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[Value Group] = "Thriving" )
		formatString: 0
		displayFolder: Value
		lineageTag: 4e382427-4f45-4f6b-92df-f95a9df4c954

	measure Efficient = CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[Value Group] = "Efficient" )
		formatString: 0
		displayFolder: Value
		lineageTag: a7cf83bc-99f9-4789-8968-ebfcc7a3c9b2

	measure 'Under-served' = CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[Value Group] = "Under-served" )
		formatString: 0
		displayFolder: Value
		lineageTag: a3366170-d8ef-4a23-9de4-b41e462a4cde

	measure 'At-risk' = CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[Value Group] = "At-risk" )
		formatString: 0
		displayFolder: Value
		lineageTag: e50f7cb5-709a-41f0-a947-63f6f3fc7838

	measure 'Value Group Colour' = SWITCH ( SELECTEDVALUE ( agg_child_summary[Value Group] ), "Thriving", "#5B7DB1", "Efficient", "#3BA55C", "Under-served", "#E5484D", "#8C8C8C" )
		displayFolder: Value
		lineageTag: a569f082-4e87-40d5-9137-5a6a99b7fc58

	measure 'Value Index Colour' = IF ( [Outcome Value Index] >= 1, "#3BA55C", "#E5484D" )
		displayFolder: Value
		lineageTag: 6299d625-263d-4942-9ea1-7c0774a6f9d8

	measure 'Avg Improvement pts' = AVERAGE ( agg_child_summary[improvement_pts] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: 5a2d71f5-bce7-4dc8-857a-cd7c198866db

	measure 'Children Improved %' = DIVIDE ( CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[improvement_pts] > 0 ), COUNTROWS ( agg_child_summary ) )
		formatString: 0%
		displayFolder: Clinical
		lineageTag: 52825ee2-31b5-4fcc-8f9e-c8b061785039

	measure 'Avg Overall Score' = AVERAGE ( fact_assessment[overall_score_pct] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: 20d47dc2-1790-4b05-b97d-a501949666e7

	measure 'Latest Overall Score' = AVERAGE ( agg_child_summary[latest_overall_score] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: f7e164c0-28db-4b9d-b59e-d5c094179162

	measure 'Red-Risk Children' = CALCULATE ( COUNTROWS ( agg_child_summary ), agg_child_summary[latest_risk] = "red" )
		formatString: 0
		displayFolder: Clinical
		lineageTag: 1397367b-c87b-4c2e-b866-79433fc4f734

	measure 'Risk Improved Children' = SUM ( agg_child_summary[risk_improved] )
		formatString: 0
		displayFolder: Clinical
		lineageTag: 7dd67c30-d0f0-4054-915e-475bcbf5ce28

	measure 'Churn-Risk Children' = SUM ( agg_child_summary[churn_risk] )
		formatString: 0
		displayFolder: Clinical
		lineageTag: 0853275c-0bd1-43f9-a2bc-10077fdc669d

	measure 'Churn-Risk %' = DIVIDE ( [Churn-Risk Children], COUNTROWS ( agg_child_summary ) )
		formatString: 0%
		displayFolder: Clinical
		lineageTag: a6ebd768-269c-4707-9b6a-d9c3d476d41d

	measure 'Domain Score' = AVERAGE ( fact_assessment_domain[score] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: ebf6cc5c-3ca8-48a8-bb7c-e72b5fd9ff61

	measure 'Domain Gain pts' = CALCULATE ( AVERAGE ( fact_assessment_domain[score] ), fact_assessment_domain[is_latest] = 1 ) - CALCULATE ( AVERAGE ( fact_assessment_domain[score] ), fact_assessment_domain[is_initial] = 1 )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: 194b1ffd-5848-4dcd-b964-a29d36b7e947

	measure 'Domain Latest Score' = CALCULATE ( AVERAGE ( fact_assessment_domain[score] ), fact_assessment_domain[is_latest] = 1 )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: a131aedf-358e-4d21-aa5e-12043ebee987

	measure 'Goal Completion %' = DIVIDE ( SUM ( fact_goal[is_completed] ), COUNTROWS ( fact_goal ) )
		formatString: 0%
		displayFolder: Clinical
		lineageTag: b88cea06-0877-43e0-9057-2be06b6177ad

	measure 'Home Tasks per Week' = AVERAGE ( fact_home_engagement_weekly[home_tasks_logged] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: d08c6142-0618-40a1-b68c-1c2756c421b7

	measure 'Meals Logged per Week' = AVERAGE ( fact_home_engagement_weekly[meals_logged] )
		formatString: 0.0
		displayFolder: Clinical
		lineageTag: f0c6aee3-a04e-491f-b314-1932fec871a9

	measure 'Alerts Raised' = COUNTROWS ( fact_alert )
		formatString: 0
		displayFolder: Alerts
		lineageTag: 2468c391-af45-4202-8c1e-b155666852c1

	measure 'Open Alerts' = SUM ( fact_alert[is_open] )
		formatString: 0
		displayFolder: Alerts
		lineageTag: f7e3051d-59c1-44d1-928e-1916a1930314

	measure 'High Severity Alerts' = CALCULATE ( COUNTROWS ( fact_alert ), fact_alert[severity] = "high" )
		formatString: 0
		displayFolder: Alerts
		lineageTag: c64e54fb-6265-4384-be8c-da097d057233

	measure 'Avg Hrs to Acknowledge' = AVERAGE ( fact_alert[hours_to_acknowledge] )
		formatString: 0.0
		displayFolder: Alerts
		lineageTag: 10586240-79fb-4a98-8df6-b84761d45a6e

	measure 'Avg Hrs to Resolve' = AVERAGE ( fact_alert[hours_to_resolve] )
		formatString: 0.0
		displayFolder: Alerts
		lineageTag: 9c69a295-3995-4ab3-ba9b-201e798ff6e0

	measure 'Acknowledged within 4h %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_alert ), fact_alert[hours_to_acknowledge] <= 4, NOT ( ISBLANK ( fact_alert[hours_to_acknowledge] ) ) ), CALCULATE ( COUNTROWS ( fact_alert ), NOT ( ISBLANK ( fact_alert[hours_to_acknowledge] ) ) ) )
		formatString: 0%
		displayFolder: Alerts
		lineageTag: da9e5bb8-8999-4b4f-88f7-ef0ed49ba3e0

	measure 'Billed INR' = CALCULATE ( SUM ( fact_payment[amount_inr] ), fact_payment[payment_type] = "subscription" )
		formatString: "₹"#,##0
		displayFolder: Revenue
		lineageTag: 8fc82430-a248-4f6b-9726-e6517f077e5a

	measure 'Collected INR' = CALCULATE ( SUM ( fact_payment[paid_amount_inr] ), fact_payment[payment_type] = "subscription" )
		formatString: "₹"#,##0
		displayFolder: Revenue
		lineageTag: 3461ae2c-62a0-490c-93ed-c37a2a09f2f4

	measure 'Outstanding INR' = CALCULATE ( SUM ( fact_payment[outstanding_inr] ), fact_payment[payment_type] = "subscription" )
		formatString: "₹"#,##0
		displayFolder: Revenue
		lineageTag: 58aaf3e5-7977-4ace-9bb0-9447fcf26d45

	measure 'Collection %' = DIVIDE ( [Collected INR], [Billed INR] )
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: a102980c-5a90-4cb9-b331-4d9d8ff701f6

	measure 'Failed Payments' = CALCULATE ( COUNTROWS ( fact_payment ), fact_payment[status] = "failed", fact_payment[payment_type] = "subscription" )
		formatString: 0
		displayFolder: Revenue
		lineageTag: fe6fed9c-2bba-488b-b676-59ce4e9ce926

	measure 'Payment Count' = CALCULATE ( COUNTROWS ( fact_payment ), fact_payment[payment_type] = "subscription" )
		formatString: 0
		displayFolder: Revenue
		lineageTag: 927d23a5-4955-4e5d-a578-06648ae5a9db

	measure 'League Value Index Check' = CALCULATE ( [Outcome Value Index], ALL ( dim_child ), ALL ( agg_child_summary ) )
		formatString: 0.000
		displayFolder: QA
		lineageTag: 82cd6c30-1c81-4a56-87f7-edf415d3b502

	measure 'Sessions Rows' = COUNTROWS ( fact_session )
		formatString: #,##0
		displayFolder: QA
		lineageTag: 7fccf468-714d-471c-9cfe-27a0796825ac

	measure 'Assessment Rows' = COUNTROWS ( fact_assessment )
		formatString: #,##0
		displayFolder: QA
		lineageTag: b8e782e2-5cc3-4a27-a456-67d624e96e49

	measure 'Payment Rows' = COUNTROWS ( fact_payment )
		formatString: #,##0
		displayFolder: QA
		lineageTag: bc8434f9-04b2-4dee-91dd-538cc9d6caaa

	measure 'Alert Rows' = COUNTROWS ( fact_alert )
		formatString: #,##0
		displayFolder: QA
		lineageTag: 4158aa7e-9dd5-44f5-9547-c945b51b0814

	column Hidden
