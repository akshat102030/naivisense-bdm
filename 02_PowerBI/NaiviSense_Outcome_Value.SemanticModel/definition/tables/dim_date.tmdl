	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\processed\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date","year","month_num","month_start","week_start","day_of_week"}),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"date", type date},{"year", Int64.Type},{"month_num", Int64.Type},{"month_name", type text},{"month_start", type date},{"week_start", type date},{"day_of_week", Int64.Type},{"day_name", type text},{"is_weekend", type text},{"is_future", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
