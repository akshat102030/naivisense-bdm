table dim_week
	lineageTag: 2a997454-e8ed-4401-a0e2-bbd17fe5305c

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 30f3e363-3825-4dd2-87df-e4d03c9db48f
		summarizeBy: none
