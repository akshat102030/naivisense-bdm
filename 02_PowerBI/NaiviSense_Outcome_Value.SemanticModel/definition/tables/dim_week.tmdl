table dim_week
	lineageTag: a9e9c52b-3b51-4bb0-9fae-e243f4d7257b

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ac0143b0-36ee-447a-84ff-f3c283626408
		summarizeBy: none
		sourceColumn: week_start

	partition dim_week = calculated
		mode: import
