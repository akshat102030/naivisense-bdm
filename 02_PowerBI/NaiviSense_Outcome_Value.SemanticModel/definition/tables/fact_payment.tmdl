	partition fact_payment = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\processed\fact_payment.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"billing_date","month_start","amount_inr","paid_amount_inr","outstanding_inr","days_to_pay"}),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"payment_id", type text},{"child_id", type text},{"parent_user_id", type text},{"billing_date", type date},{"month_start", type date},{"payment_type", type text},{"status", type text},{"amount_inr", Int64.Type},{"paid_amount_inr", Int64.Type},{"outstanding_inr", Int64.Type},{"days_to_pay", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
