    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Metrics",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Progress Points = 10 × (latest − initial overall assessment score) + 20 × (second-half − first-half average session score) + 5 × goals completed, floored at 0.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Outcome Value Index = (child progress ÷ centre progress) ÷ (child fees ÷ centre fees). 1.00 = fair value.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fair Value = centre fees × child's share of progress. Overpay = fees − fair value.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Value groups use the median fee and median progress: Thriving (high/high), Efficient (low fee, high progress), Under-served (high fee, low progress), At-risk (low/low).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Therapist value shares each child's progress and fees by the therapist's share of attended sessions.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Churn risk = attendance < 70%, or red band with < 3 pts gain, or 2+ failed payments.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F1D1A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
